#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        excl_mark: excl_mark {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp LS(MINUS)>;
            label = "EXCL_MARK";
        };
    };

    behaviors {
        td_qst_mark: td_qst_mark {
            compatible = "zmk,behavior-tap-dance";
            label = "QuestionMarks";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&kp LS(MINUS)>, <&kp LS(EQUAL)>;
        };

        td_excl_mark: td_excl_mark {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_EXCL_MARK";
            #binding-cells = <0>;
            bindings = <&kp LS(NUMBER_1)>, <&kp EQUAL>;

            tapping-term-ms = <350>;
        };

        td_parenthesis: td_parenthesis {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PARENTHESIS";
            #binding-cells = <0>;
            bindings = <&kp LS(N8)>, <&kp LS(N9)>;

            tapping-term-ms = <350>;
        };

        td_equals_plus: td_equals_plus {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_EQUALS_PLUS";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&kp LS(NUMBER_0)>, <&kp RIGHT_BRACKET>;
        };

        td_two_symbols: td_two_symbols {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_TWO_SYMBOLS";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_2>, <&kp LS(NUMBER_2)>, <&kp RA(NUMBER_2)>;

            tapping-term-ms = <350>;
        };

        td_one_symbols: td_one_symbols {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ONE_SYMBOLS";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_1>, <&kp LS(NUMBER_1)>, <&kp RA(NUMBER_1)>;

            tapping-term-ms = <350>;
        };

        td_three_symbols: td_three_symbols {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_THREE_SYMBOLS";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&kp NUMBER_3>, <&kp LS(NUMBER_3)>, <&kp RA(NUMBER_3)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        JKL_Enter {
            bindings = <&kp ENTER>;
            key-positions = <16 17 18>;
        };

        QWE_Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T                                       &kp Y            &kp U  &kp I      &kp O       &kp P
&kp A  &kp S  &kp D  &kp F  &kp G                                       &kp H            &kp J  &kp K      &kp L       &kp SEMICOLON
&kp Z  &kp X  &kp C  &kp V  &kp B                                       &kp N            &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
                            &mo 1  &mt LEFT_CONTROL SPACE    &kp ENTER  &lt 2 BACKSPACE
            >;
        };

        left-mod {
            bindings = <
&none   &none           &kp UP_ARROW    &none            &none                     &kp N7           &kp N8        &kp N9        &kp N0  &none
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none                     &kp NUMBER_4     &kp N5        &kp NUMBER_6  &trans  &trans
&trans  &trans          &trans          &trans           &trans                    &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
                                                         &trans  &trans    &trans  &lt 3 BACKSPACE
            >;
        };

        right_mod {
            bindings = <
&kp LS(NUMBER_1)  &td_two_symbols  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)                    &kp LS(NUMBER_6)  &kp LS(N7)  &kp LS(N8)        &kp LS(N9)  &kp LS(N0)
&trans            &trans           &trans            &trans            &trans                              &none             &trans      &kp RA(NUMBER_2)  &trans      &kp SINGLE_QUOTE
&trans            &trans           &trans            &trans            &trans                              &td_qst_mark      &none       &trans            &trans      &trans
                                                                       &mo 3             &trans    &trans  &trans
            >;
        };

        combo_layer {
            bindings = <
&kp TAB  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &tog 4                    &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                 &trans  &trans    &trans  &trans
            >;
        };

        gaming {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                 &trans           &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                                 &trans           &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                                 &trans           &trans  &trans  &trans  &trans
                                &kp LEFT_CONTROL  &kp SPACE    &trans  &lt 3 BACKSPACE
            >;
        };
    };
};
