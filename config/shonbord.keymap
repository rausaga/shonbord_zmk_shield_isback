#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T                                        &kp Y                 &kp U  &kp I      &kp O       &kp P
&kp A  &kp S  &kp D  &kp F  &kp G                                        &kp H                 &kp J  &kp K      &kp L       &kp SEMICOLON
&kp Z  &kp X  &kp C  &kp V  &kp B                                        &kp N                 &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
                            &kp LEFT_SHIFT  &lt 1 SPACE    &lt 2 RETURN  &mt DELETE BACKSPACE
            >;
        };

        left-mod {
            bindings = <
&none   &none   &none   &none   &none                     &kp N7        &kp N8        &kp N9        &kp N0  &none
&trans  &trans  &trans  &trans  &trans                    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
                                &trans  &trans    &trans  &trans
            >;
        };

        right_mod {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans    &trans  &trans
            >;
        };
    };
};
