#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        excl_mark: excl_mark {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp LS(MINUS)>;
            label = "EXCL_MARK";
        };
    };

    behaviors {
        td_qst_mark: td_qst_mark {
            compatible = "zmk,behavior-tap-dance";
            label = "QuestionMarks";
            #binding-cells = <0>;
            tapping-term-ms = <350>;
            bindings = <&kp MINUS>, <&kp LS(EQUAL)>;
        };

        td_excl_mark: td_excl_mark {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_EXCL_MARK";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_1>, <&kp EQUAL>;

            tapping-term-ms = <350>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T                                               &kp Y          &kp U  &kp I      &kp O       &mt LEFT_ALT P
&kp A  &kp S  &kp D  &kp F  &kp G                                               &kp H          &kp J  &kp K      &kp L       &kp SEMICOLON
&kp Z  &kp X  &kp C  &kp V  &kp B                                               &kp N          &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
                            &mt LEFT_SHIFT DELETE  &lt 1 SPACE    &lt 2 RETURN  &kp BACKSPACE
            >;
        };

        left-mod {
            bindings = <
&none   &none   &none     &kp UP_ARROW    &none                        &kp N7        &kp N8        &kp N9        &kp N0  &none
&trans  &trans  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT                    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans  &trans
&trans  &trans  &trans    &trans          &trans                       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans
                                          &trans     &trans    &trans  &trans
            >;
        };

        right_mod {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans        &trans         &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans        &trans         &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &td_qst_mark  &td_excl_mark  &trans  &trans  &trans
                                &trans  &trans    &trans  &trans
            >;
        };

        combo_layer {
            bindings = <
&kp TAB  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                 &trans  &trans    &trans  &trans
            >;
        };
    };
};
